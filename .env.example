# Canonical site origin used for metadata, robots.txt and sitemap.xml.
# Falls back to the Vercel deployment URL, then to the production alias.
NEXT_PUBLIC_SITE_URL=

# Web3Forms public access key for the contact form (domain-lock it in the
# Web3Forms dashboard). NEXT_PUBLIC_ so the client bundle can read it.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
